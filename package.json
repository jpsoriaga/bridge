{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lets a chat in the browser propose file edits that a local desktop app applies to your project.",
  "scripts": {
    "dev": "pnpm --parallel --filter @bridge/desktop --filter @bridge/extension dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "package:mac": "pnpm --filter @bridge/desktop package:mac",
    "package:win": "pnpm --filter @bridge/desktop package:win"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  }
}
