{
  "manifest_version": 3,
  "name": "Bridge - AI Code Sync",
  "version": "0.1.0",
  "description": "Securely relay AI @@FILE code blocks from your browser to Bridge desktop.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Bridge"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
