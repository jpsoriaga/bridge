<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for signed builds: only what Electron needs to run (V8's JIT),
  as in @electron/osx-sign's defaults minus the camera, microphone, location, Bluetooth, USB
  and printing that Bridge never uses. Unsigned builds don't use hardened runtime.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
